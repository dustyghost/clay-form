+/// Keep spare vertex storage below one dirty-write block, bounded by the
+/// binding limit. Crossing a block in either direction resizes the allocation.
+pub(super) fn vertex_capacity(bytes: usize, limit: usize) -> usize {
+    if bytes == 0 {
+        return 16;
+    }
+    debug_assert!(bytes.is_multiple_of(4) && bytes <= limit);
+    bytes.div_ceil(BLOCK).saturating_mul(BLOCK).min(limit & !3)
+}
+
+pub(super) fn vertex_buffer(
+    device: &super::wgpu::Device,
+    bytes: &[u8],
+    limit: usize,
+) -> super::wgpu::Buffer {
+    let buffer = device.create_buffer(&super::wgpu::BufferDescriptor {
+        label: Some("mesh vertices"),
+        size: vertex_capacity(bytes.len(), limit) as u64,
+        usage: super::wgpu::BufferUsages::STORAGE | super::wgpu::BufferUsages::COPY_DST,
+        mapped_at_creation: !bytes.is_empty(),
+    });
+    if !bytes.is_empty() {
+        buffer.slice(..).get_mapped_range_mut()[..bytes.len()].copy_from_slice(bytes);
+        buffer.unmap();
+    }
+    buffer
+}
+
+pub(super) fn write_vertices(
+    device: &super::wgpu::Device,
+    queue: &super::wgpu::Queue,
+    target: &mut super::wgpu::Buffer,
+    bytes: &[u8],
+    limit: usize,
+) {
+    if target.size() == vertex_capacity(bytes.len(), limit) as u64 {
+        if !bytes.is_empty() {
+            queue.write_buffer(target, 0, bytes);
+        }
+    } else {
+        *target = vertex_buffer(device, bytes, limit);
+    }
+}
