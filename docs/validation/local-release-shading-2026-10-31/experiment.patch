+    #[test]
+    fn local_shading_keeps_exact_fan_sums_across_edits_and_restoration() {
+        let reference = Mesh::starting_sphere();
+        let topology = SurfaceShadingTopology::new(&reference);
+        let shading = topology.shade(&reference);
+        let mut mesh = reference.clone();
+        assert_local_reference(&topology, &shading, &mesh);
+        assert!(topology.reference_smooth.get().is_some());
+        for vertex in [0, 7, 35] {
+            mesh.vertices[vertex].2 += 0.0001;
+            assert_local_reference(&topology, &shading, &mesh);
+        }
+        assert!(topology.reference_smooth.get().is_some());
+        assert_local_reference(&topology, &shading, &reference);
+        let zero = mesh.vertices.iter_mut().find(|p| p.0 == 0.).unwrap();
+        zero.0 = if zero.0.to_bits() == 0 { -0. } else { 0. };
+        assert_local_reference(&topology, &shading, &mesh);
+    }
+
+    fn local_plane() -> Mesh {
+        let mut mesh = Mesh::default();
+        for y in 0..9 {
+            for x in 0..9 {
+                mesh.vertices.push(Vec3(x as f32, y as f32, 0.));
+            }
+        }
+        for y in 0..8 {
+            for x in 0..8 {
+                let a = y * 9 + x;
+                mesh.triangles
+                    .extend([[a, a + 1, a + 10], [a, a + 10, a + 9]]);
+            }
+        }
+        mesh
+    }
+
+    #[test]
+    fn local_shading_falls_back_for_broad_edits_and_fan_splits_or_merges() {
+        let flat = local_plane();
+        let mut sharp = flat.clone();
+        sharp.vertices[40].2 = 4.;
+        for (reference, edited) in [(&flat, &sharp), (&sharp, &flat)] {
+            let topology = SurfaceShadingTopology::new(reference);
+            let shading = topology.shade(reference);
+            assert_ne!(shading.triangles, reference_shading(edited).triangles);
+            assert!(
+                topology
+                    .local_vertices(edited, &shading.vertices, &shading.triangles)
+                    .is_none()
+            );
+        }
+        let topology = SurfaceShadingTopology::new(&flat);
+        let shading = topology.shade(&flat);
+        let mut broad = flat.clone();
+        for p in &mut broad.vertices {
+            p.2 += 0.1;
+        }
+        assert!(
+            topology
+                .local_vertices(&broad, &shading.vertices, &shading.triangles)
+                .is_none()
+        );
+        assert!(topology.reference_smooth.get().is_some());
+        // A single high-valence edit can still touch too much of the surface.
+        let mut fan = flat.clone();
+        fan.triangles = (1..80).map(|i| [0, i, i + 1]).collect();
+        let topology = SurfaceShadingTopology::new(&fan);
+        let shading = topology.shade(&fan);
+        fan.vertices[0].2 = 0.01;
+        assert!(
+            topology
+                .local_vertices(&fan, &shading.vertices, &shading.triangles)
+                .is_none()
+        );
+        assert!(topology.reference_smooth.get().is_some());
+    }
+
+    #[test]
+    fn local_shading_preserves_open_creased_degenerate_and_nonmanifold_fans() {
+        for case in 0..4 {
+            let mut reference = local_plane();
+            match case {
+                1 => reference.creases = vec![[30, 40]],
+                2 => reference.triangles.push([40, 40, 41]),
+                3 => reference.triangles.extend_from_within(70..73),
+                _ => {}
+            }
+            let topology = SurfaceShadingTopology::new(&reference);
+            let shading = topology.shade(&reference);
+            let mut edited = reference.clone();
+            edited.vertices[40].2 = 0.001;
+            assert_local_reference(&topology, &shading, &edited);
+        }
+    }
