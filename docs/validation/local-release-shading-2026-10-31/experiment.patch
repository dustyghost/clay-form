diff --git a/src/viewport/gpu/display/stroke_tests.rs b/src/viewport/gpu/display/stroke_tests.rs
index 3153d29..e2c08ba 100644
--- a/src/viewport/gpu/display/stroke_tests.rs
+++ b/src/viewport/gpu/display/stroke_tests.rs
@@ -688,0 +689,40 @@ fn shared_display_arrays_follow_mixed_edits_and_preserve_older_snapshots() {
+
+#[test]
+fn local_release_reuses_canonical_fans_and_preserves_hidden_snapshots() {
+    for hidden in [false, true] {
+        let mut mesh = source();
+        if !hidden {
+            mesh.hidden_faces.clear();
+        }
+        let original = mesh.clone();
+        let mut display = Arc::new(DisplayMesh::new(&document(mesh.clone())));
+        let topology = display.stroke_topology.as_ref().unwrap().source.clone();
+        let reference = topology.canonical.get().unwrap();
+        let vertex = mesh
+            .vertices
+            .iter()
+            .position(|p| p.2 > 0.99 && p.0 <= 0.)
+            .unwrap();
+        for height in [0.0001, 0.0002, 0.] {
+            mesh.vertices[vertex].2 = original.vertices[vertex].2 + height;
+            let mut doc = document(mesh.clone());
+            let old_bytes = display.vertices(display.vertex_stride());
+            doc.begin_stroke();
+            let live = Arc::new(display.during_stroke(&doc).unwrap());
+            doc.end_stroke();
+            let released = live.after_stroke(&doc).unwrap();
+            assert!(Arc::ptr_eq(
+                &released.stroke_topology.as_ref().unwrap().fans,
+                &reference.triangles
+            ));
+            let canonical = DisplayMesh::new(&doc);
+            assert_visible_data(&released, &canonical);
+            assert_eq!(
+                released.vertices(released.vertex_stride()),
+                canonical.vertices(canonical.vertex_stride())
+            );
+            assert_eq!(display.vertices(display.vertex_stride()), old_bytes);
+            display = released;
+        }
+    }
+}
