+    fn assert_local_reference(
+        topology: &SurfaceShadingTopology,
+        original: &SurfaceShading,
+        mesh: &Mesh,
+    ) {
+        let vertices = topology
+            .local_vertices(mesh, &original.vertices, &original.triangles)
+            .expect("small edit keeps smoothing connectivity");
+        let expected = reference_shading(mesh);
+        assert_eq!(original.triangles, expected.triangles);
+        assert_eq!(vertices.len(), expected.vertices.len());
+        for ((i, a), (j, b)) in vertices.iter().zip(&expected.vertices) {
+            assert_eq!(i, j);
+            assert_eq!(
+                [a.0.to_bits(), a.1.to_bits(), a.2.to_bits()],
+                [b.0.to_bits(), b.1.to_bits(), b.2.to_bits()]
+            );
+        }
+    }
